<?xml version="1.0" encoding="utf-8"?>
<!--
  Example Appcast for Navo / upgrader (Sparkle-style RSS).

  Host this file (or a production copy) at https://www.navo.im/appcast.xml
  (see LegalUrls.appcast / AppUpgrader.appcastURL).

  Each <item> targets one OS via sparkle:os. upgrader picks the best match
  for the running platform and compares sparkle:version to the installed
  package version (pubspec.yaml version / CFBundleShortVersionString).

  Optional force update: add inside an item
    <sparkle:tags><sparkle:criticalUpdate /></sparkle:tags>

  Store-distributed builds should prefer the store update UI; keep Appcast
  for sideload / desktop channels.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Navo Appcast</title>
    <language>en</language>

